#!/usr/bin/env sh
# Axon .deb postinst — 安装后执行
set -e

PACKAGE_ROOT="/usr/share/axon"
VERSION="__VERSION__"
RELEASE_NAME="__RELEASE_NAME__"

resolve_target_user() {
    if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
        printf '%s\n' "${SUDO_USER}"
        return 0
    fi
    if [ -n "${PKEXEC_UID:-}" ]; then
        id -nu "${PKEXEC_UID}" 2>/dev/null
        return $?
    fi
    if [ "${USER:-}" ] && [ "${USER}" != "root" ]; then
        printf '%s\n' "${USER}"
        return 0
    fi
    return 1
}

TARGET_USER="$(resolve_target_user || true)"
if [ -n "${TARGET_USER}" ]; then
    TARGET_HOME="$(getent passwd "${TARGET_USER}" | cut -d: -f6)"
else
    TARGET_USER="root"
    TARGET_HOME="/root"
fi
TARGET_HOME="${TARGET_HOME:-/root}"
TARGET_GROUP="$(id -gn "${TARGET_USER}")"
INSTALL_ROOT="${TARGET_HOME}/.axon/bin"
INSTALL_BIN="${INSTALL_ROOT}/axon"
LAUNCHER="${INSTALL_ROOT}/launcher/axon-launcher"
SOUL_TEMPLATE="${PACKAGE_ROOT}/defaults/SOUL.md"
PAYLOAD_RELEASE="${PACKAGE_ROOT}/versions/${RELEASE_NAME}/axon"
PAYLOAD_LAUNCHER="${PACKAGE_ROOT}/launcher/axon-launcher"

run_as_target() {
    if [ "${TARGET_USER}" = "$(id -un)" ]; then
        "$@"
    elif command -v runuser >/dev/null 2>&1; then
        runuser -u "${TARGET_USER}" -- "$@"
    else
        su -s /bin/sh "${TARGET_USER}" -c "$(printf '%q ' "$@")"
    fi
}

install_default_soul() {
    [ -f "${SOUL_TEMPLATE}" ] || return 0
    SOUL_DIR="${TARGET_HOME}/.axon"
    SOUL_FILE="${SOUL_DIR}/SOUL.md"
    if [ -e "${SOUL_FILE}" ] || [ -L "${SOUL_FILE}" ]; then
        return 0
    fi
    if [ ! -d "${SOUL_DIR}" ]; then
        install -d -m 700 -o "${TARGET_USER}" -g "${TARGET_GROUP}" "${SOUL_DIR}"
    fi
    install -m 600 -o "${TARGET_USER}" -g "${TARGET_GROUP}" "${SOUL_TEMPLATE}" "${SOUL_FILE}"
}

install -d -m 755 -o "${TARGET_USER}" -g "${TARGET_GROUP}" "${INSTALL_ROOT}/versions/${RELEASE_NAME}" "${INSTALL_ROOT}/launcher"
install -m 755 -o "${TARGET_USER}" -g "${TARGET_GROUP}" "${PAYLOAD_RELEASE}" "${INSTALL_ROOT}/versions/${RELEASE_NAME}/axon"
install -m 755 -o "${TARGET_USER}" -g "${TARGET_GROUP}" "${PAYLOAD_LAUNCHER}" "${LAUNCHER}"
install_default_soul

CURRENT_NEXT="${INSTALL_ROOT}/.current.$$"
printf '{"versionId":"%s"}\n' "${RELEASE_NAME}" > "${CURRENT_NEXT}"
chown "${TARGET_USER}:${TARGET_GROUP}" "${CURRENT_NEXT}"
mv -f "${CURRENT_NEXT}" "${INSTALL_ROOT}/current.json"
for RELEASE_DIR in "${INSTALL_ROOT}/versions"/*; do
    [ -d "${RELEASE_DIR}" ] || continue
    [ "$(basename "${RELEASE_DIR}")" = "${RELEASE_NAME}" ] || rm -rf -- "${RELEASE_DIR}"
done
ln -sfn "${LAUNCHER}" "${INSTALL_BIN}"
chown -h "${TARGET_USER}:${TARGET_GROUP}" "${INSTALL_BIN}" 2>/dev/null || true

PATH_PROFILE="${TARGET_HOME}/.profile"
PATH_LINE='export PATH="$HOME/.axon/bin:$PATH"'
if ! grep -Fqx "${PATH_LINE}" "${PATH_PROFILE}" 2>/dev/null; then
    printf '\n%s\n' "${PATH_LINE}" >> "${PATH_PROFILE}"
fi
chown "${TARGET_USER}:${TARGET_GROUP}" "${PATH_PROFILE}" 2>/dev/null || true

run_as_target "${LAUNCHER}" daemon install || echo "警告：Daemon 用户服务注册失败，请运行 axon daemon install 重试。" >&2

echo ""
echo "Axon 安装完成：${INSTALL_BIN}"
echo "运行 'axon --help' 开始使用。"
echo ""

exit 0
